{
  "name": "e2e-test-serverest-platform",
  "version": "1.0.0",
  "description": "E2E Test Automation Platform for ServeRest",
  "main": "cypress.config.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run --env allure=true",
    "allure:clear": "rimraf allure-results allure-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "test": "npm run allure:clear && npm run cy:run"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.5.0",
    "@mmisty/cypress-allure-adapter": "^4.0.1",
    "allure-commandline": "^2.32.0",
    "cypress": "15.8.0",
    "rimraf": "^6.0.1"
  }
}